# Vorlage für die lokale Konfiguration.
# Kopiere diese Datei nach "backend/.env" und trage deinen Schlüssel ein.
# Die Datei .env steht in der .gitignore und landet nie auf GitHub.

# API-Schlüssel für die KI-Erklärungen (https://platform.claude.com)
PI_ANTHROPIC_API_KEY=

# Optional: anderes Modell und Grenze für Anfragen pro Stunde
# PI_LLM_MODEL=claude-haiku-4-5-20251001
# PI_LLM_REQUESTS_PER_HOUR=30

# Optional: Speicher. Logs ohne Nutzung werden nach so vielen Tagen gelöscht (0 = nie),
# und der Speicherordner wird auf so viele MB begrenzt (0 = keine Grenze).
# PI_RETENTION_DAYS=7
# PI_MAX_STORAGE_MB=2000
